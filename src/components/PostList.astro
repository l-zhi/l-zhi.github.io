---
import { postUrl, formatDate, type Post } from '../lib/posts';
import VideoDialog from './VideoDialog.astro';
interface Props { posts: Post[]; showVideos?: boolean }
const { posts, showVideos = false } = Astro.props;
---
<ul class="post-list">
  {posts.map(post => <li class:list={{ 'has-video-preview': showVideos && !!post.data.video }}>
    <div class="post-copy">
      <div class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{post.data.draft && <span>草稿</span>}</div>
      <h2><a href={postUrl(post)}>{post.data.title}</a></h2>
      <p>{post.data.description}</p>
      {post.data.tags.length > 0 && <div class="post-tags">{post.data.tags.map(tag => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div>}
    </div>
    {showVideos && post.data.video && <a
      class="post-video-preview"
      href={`https://www.bilibili.com/video/${post.data.video.bvid}/`}
      target="_blank" rel="noopener noreferrer"
      data-video-bvid={post.data.video.bvid}
      data-video-title={post.data.video.title}
      aria-label={`播放视频：${post.data.video.title}（${post.data.video.duration}）`}
    >
      <span class="video-poster">
        <img src={post.data.video.poster} alt="" width="1920" height="1080" loading="lazy" decoding="async" />
        <span class="video-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
        <span class="video-duration">{post.data.video.duration}</span>
      </span>
      <span class="video-caption">观看视频 ↗</span>
    </a>}
  </li>)}
</ul>
{showVideos && posts.some(post => post.data.video) && <VideoDialog />}
<style>
  .has-video-preview { display: grid; grid-template-columns: minmax(0, 1fr) 184px; gap: 24px; align-items: start; }
  .post-copy { min-width: 0; }
  .post-video-preview { display: block; text-decoration: none; margin-top: 5px; }
  .video-poster { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; border: 1px solid var(--line); border-radius: 6px; background: var(--soft); }
  img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .video-play { position: absolute; inset: 0; display: grid; place-content: center; width: 40px; height: 40px; margin: auto; border: 1px solid #ffffff88; border-radius: 50%; color: #fff; background: #111b; }
  .post-video-preview:hover .video-play, .post-video-preview:focus-visible .video-play { background: #111e; }
  .video-duration { position: absolute; right: 5px; bottom: 5px; padding: 0 5px; border-radius: 3px; background: #111d; color: #fff; font-size: 11px; line-height: 1.7; }
  .video-caption { display: block; margin-top: 6px; color: var(--muted); font-size: 12px; }
  @media (max-width: 620px) {
    .has-video-preview { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .post-video-preview { width: 184px; max-width: 100%; margin-top: 0; }
  }
</style>
