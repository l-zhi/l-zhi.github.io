---
import { postUrl, formatDate, type Post } from '../lib/posts';
interface Props { posts: Post[] }
const { posts } = Astro.props;
---
<ul class="post-list">
  {posts.map(post => <li>
    <div class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{post.data.draft && <span>草稿</span>}</div>
    <h2><a href={postUrl(post)}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    {post.data.tags.length > 0 && <div class="post-tags">{post.data.tags.map(tag => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}</div>}
  </li>)}
</ul>
