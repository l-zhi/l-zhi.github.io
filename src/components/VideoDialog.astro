<dialog class="video-dialog" aria-labelledby="video-dialog-title">
  <div class="video-dialog-panel">
    <header>
      <h2 id="video-dialog-title">观看视频</h2>
      <form method="dialog"><button type="submit" aria-label="关闭视频" autofocus>×</button></form>
    </header>
    <div class="video-dialog-player"></div>
    <footer><a class="video-dialog-external" target="_blank" rel="noopener noreferrer">在 B 站观看 ↗</a></footer>
  </div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('.video-dialog');
  if (dialog && typeof dialog.showModal === 'function') {
    const title = dialog.querySelector<HTMLHeadingElement>('h2')!;
    const player = dialog.querySelector<HTMLDivElement>('.video-dialog-player')!;
    const external = dialog.querySelector<HTMLAnchorElement>('.video-dialog-external')!;
    let opener: HTMLAnchorElement | undefined;
    let previousOverflow = '';
    document.querySelectorAll<HTMLAnchorElement>('a[data-video-bvid]').forEach(link => {
      link.addEventListener('click', event => {
        if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        opener = link;
        title.textContent = link.dataset.videoTitle!;
        external.href = link.href;
        const iframe = document.createElement('iframe');
        iframe.src = `https://player.bilibili.com/player.html?bvid=${link.dataset.videoBvid}&page=1&autoplay=1`;
        iframe.title = `B 站视频：${link.dataset.videoTitle}`;
        iframe.allow = 'autoplay; fullscreen; picture-in-picture';
        iframe.allowFullscreen = true;
        player.replaceChildren(iframe);
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        dialog.showModal();
      });
    });
    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => {
      player.replaceChildren();
      document.body.style.overflow = previousOverflow;
      opener?.focus({ preventScroll: true });
    });
  }
</script>
<style>
  dialog { width: min(960px, calc(100vw - 32px)); max-width: none; max-height: calc(100dvh - 32px); padding: 0; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--text); }
  dialog::backdrop { background: #000b; }
  .video-dialog-panel { min-width: 0; }
  header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; }
  h2 { margin: 0; font-size: 16px; line-height: 1.5; overflow-wrap: anywhere; }
  form { margin: 0; }
  button { display: grid; place-content: center; width: 40px; height: 40px; border: 0; border-radius: 5px; background: var(--soft); font-size: 28px; cursor: pointer; }
  .video-dialog-player { aspect-ratio: 16 / 9; background: #161616; }
  .video-dialog-player :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  footer { padding: 10px 16px; text-align: right; font-size: 12px; }
  footer a { color: var(--accent); }
</style>
