---
import type { Post } from '../lib/posts';
interface Props { video: NonNullable<Post['data']['video']> }
const { video } = Astro.props;
---
<figure class="article-video" aria-label={`视频：${video.title}`}>
  <iframe
    src={`https://player.bilibili.com/player.html?bvid=${video.bvid}&page=1&autoplay=0`}
    title={`B 站视频：${video.title}`}
    loading="lazy"
    allow="fullscreen; picture-in-picture"
    allowfullscreen
  ></iframe>
  <figcaption><span>视频 · {video.duration}</span><a href={`https://www.bilibili.com/video/${video.bvid}/`} target="_blank" rel="noopener noreferrer">在 B 站观看 ↗</a></figcaption>
</figure>
<style>
  .article-video { margin: 0 0 28px; }
  iframe { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 7px; background: #161616; }
  figcaption { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 16px; margin-top: 8px; color: var(--muted); font-size: 12px; }
  a { color: var(--accent); }
</style>
