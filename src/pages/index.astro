---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';
import RecentProjects from '../components/RecentProjects.astro';
import { getPosts } from '../lib/posts';
import { SITE } from '../config';
const posts = await getPosts();
---
<Layout>
  <RecentProjects />
  <div class="home-contact">
    <a class="contact-button" href={`mailto:${SITE.email}`} title={`发送邮件至 ${SITE.email}`}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></svg>
      联系我
    </a>
  </div>
  <div class="section-title"><h2>最近的文字</h2><a href="/archives/">{posts.length} 篇记录 →</a></div>
  <PostList posts={posts.slice(0, SITE.pageSize)} showVideos />
  <nav class="pagination" aria-label="首页分页"><span>第 1 页</span><a href="/page/2/">更早的文章 →</a></nav>
</Layout>
<style>
  .home-contact { display: flex; justify-content: flex-end; margin: -4px 0 24px; }
  .contact-button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 7px 14px; border: 1px solid var(--line); border-radius: 5px; background: var(--bg); font-size: 14px; text-decoration: none; }
  .contact-button:hover { border-color: var(--accent); background: var(--soft); }
</style>
