---
import Layout from '../../layouts/Layout.astro';
import ProjectRepository from '../../components/ProjectRepository.astro';
import { projects, projectUrl } from '../../projects';
---
<Layout title="AI项目" description="立之的 AI 项目：ai-rss、pith-wiki、mcc、荔枝头像和荔枝排班，从学习与日常生活中的真实问题出发。">
  <h1 class="page-heading">AI项目</h1>
  <p class="page-description">为自己和身边的人，做一些用得上的小工具。</p>
  <ul class="project-list">
    {projects.map(project => (
      <li>
        <a class="project-list-image" href={projectUrl(project)} aria-label={`查看${project.name}项目介绍`}>
          <img src={project.image.src} alt={project.image.alt} width={160} height={110} loading="lazy" decoding="async" />
        </a>
        <div>
          <span class="eyebrow">{project.category}</span>
          <h2><a href={projectUrl(project)}>{project.name}</a></h2>
          <p>{project.description}</p>
          <div class="project-list-links"><a href={projectUrl(project)}>项目介绍 →</a>{project.github && <ProjectRepository url={project.github} />}</div>
        </div>
      </li>
    ))}
  </ul>
</Layout>
<style>
  .project-list { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 160px minmax(0,1fr); align-items: start; gap: 24px; padding: 26px 0; border-top: 1px solid var(--line); }
  img { width: 160px; height: 110px; object-fit: cover; display: block; border: 1px solid var(--line); border-radius: 6px; background: var(--soft); }
  h2 { margin: 4px 0 8px; font-size: 21px; line-height: 1.4; }
  h2 a { text-decoration: none; }
  p { font-size: 14px; margin: 0 0 14px; color: var(--muted); }
  .project-list-links { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 20px; font-size: 12px; }
  @media (max-width: 540px) { li { grid-template-columns: minmax(0,1fr); gap: 15px; } }
</style>
